# ============================================================
# WP Auditor — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=auditor
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=wp_audits

# ── Application ───────────────────────────────────────────
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
DEBUG=false
FRONTEND_URL=http://localhost:3000

# ── AI Keys (bring your own) ──────────────────────────────
# Choose "openai" or "gemini"
AI_PROVIDER=openai

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ── Google APIs ───────────────────────────────────────────
# Get a free key at https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=AIza...

# ── Resend (Transactional Email) ──────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=audits@yourdomain.com
RESEND_FROM_NAME=WP Auditor

# Email address for audit alerts (can be overridden per site)
ALERT_EMAIL=alerts@yourdomain.com

# ── Auth ──────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
